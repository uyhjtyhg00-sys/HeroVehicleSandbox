#pragma once

#include "CoreMinimal.h"
#include "GameFramework/Character.h"
#include "HeroTypes.h"
#include "HeroCharacter.generated.h"

class AHeroDriveableVehiclePawn;
class UCameraComponent;
class UHeroHealthComponent;
class UHeroTeamComponent;
class UHeroVehicleModeComponent;
class UHeroWeaponComponent;

UCLASS()
class HEROVEHICLESANDBOX_API AHeroCharacter : public ACharacter
{
    GENERATED_BODY()

public:
    // 기능: 1인칭 영웅 캐릭터의 카메라, 무기, 체력, 팀, 이동 기본값을 구성한다.
    AHeroCharacter();

    // 기능: 저장된 조준 설정을 로드하고 체력/모드 이벤트를 연결한다.
    virtual void BeginPlay() override;

    // 기능: 매 프레임 카메라 높이와 조준 FOV 전환을 갱신한다.
    virtual void Tick(float DeltaSeconds) override;

    // 기능: 영웅 상태의 이동/시점/전투/탑승 입력을 바인딩한다.
    virtual void SetupPlayerInputComponent(UInputComponent* PlayerInputComponent) override;

    // 기능: 앉기 시작 시 기본 Character crouch 처리를 유지한다.
    virtual void OnStartCrouch(float HalfHeightAdjust, float ScaledHalfHeightAdjust) override;

    // 기능: 앉기 종료 시 기본 Character crouch 처리를 유지한다.
    virtual void OnEndCrouch(float HalfHeightAdjust, float ScaledHalfHeightAdjust) override;

    // 기능: 1인칭 카메라 컴포넌트를 반환한다.
    UCameraComponent* GetFirstPersonCamera() const;

    // 기능: 영웅 무기 컴포넌트를 반환한다.
    UHeroWeaponComponent* GetWeaponComponent() const;

    // 기능: 영웅 체력 컴포넌트를 반환한다.
    UHeroHealthComponent* GetHealthComponent() const;

    // 기능: 기존 가짜 차량 모드 컴포넌트를 반환한다. 실제 주행은 AHeroDriveableVehiclePawn이 담당한다.
    UHeroVehicleModeComponent* GetVehicleModeComponent() const;

    // 기능: 팀 컴포넌트를 반환한다.
    UHeroTeamComponent* GetTeamComponent() const;

    // 기능: 설정 UI/저장 데이터에서 받은 조준 설정을 캐릭터에 적용한다.
    UFUNCTION(BlueprintCallable, Category="Hero|Settings")
    void ApplyAimSettings(const FHeroAimSettings& NewSettings);

    // 기능: 현재 조준 설정을 반환한다.
    UFUNCTION(BlueprintCallable, Category="Hero|Settings")
    const FHeroAimSettings& GetAimSettings() const;

    // 기능: 현재 앉은 상태인지 반환한다.
    UFUNCTION(BlueprintCallable, Category="Hero|Movement")
    bool IsHeroCrouching() const;

    // 기능: 총기 반동/피격 흔들림처럼 마우스 반전 옵션과 무관해야 하는 카메라 킥을 적용한다.
    UFUNCTION(BlueprintCallable, Category="Hero|Camera")
    void ApplyViewKick(float PitchKickDegrees, float YawKickDegrees = 0.0f);

protected:
    // 기능: W/S 입력을 영웅 전후 이동으로 처리한다.
    void MoveForward(float Value);

    // 기능: A/D 입력을 영웅 좌우 이동으로 처리한다.
    void MoveRight(float Value);

    // 기능: 마우스 X 입력을 Overwatch yaw 0.0066 기반 수평 회전으로 처리한다.
    void Turn(float Value);

    // 기능: 마우스 Y 입력을 설정 반전 옵션만 반영해 수직 회전으로 처리한다.
    void LookUp(float Value);

    // 기능: 현재 무기 발사를 시작한다.
    void StartFire();

    // 기능: 현재 무기 발사를 중지한다.
    void StopFire();

    // 기능: 조준 상태를 시작해 줌 FOV 전환을 유도한다.
    void StartAim();

    // 기능: 조준 상태를 해제해 기본 FOV로 복귀시킨다.
    void StopAim();

    // 기능: 현재 무기를 재장전한다.
    void Reload();

    // 기능: 앉기 입력을 시작한다.
    void StartHeroCrouch();

    // 기능: 앉기 입력을 해제한다.
    void StopHeroCrouch();

    // 기능: 가짜 속도 모드 대신 근처 차량 탑승/스폰 탑승을 실행한다.
    void ToggleVehicleMode();

    // 기능: 상호작용 키로도 실제 차량 탑승을 실행한다.
    void Interact();
    // Function: Perform a short-range hero melee attack. Bound to F.
    void MeleeAttack();
    // Function: Development-only vehicle spawn. Bound to Ctrl+S.
    void DevSpawnVehicleForTesting();

    // 기능: 체력이 0이 되었을 때 입력과 무기를 중지한다.
    UFUNCTION()
    void HandleDeath();

private:
    // 기능: CharacterMovement의 지상/공중/앉기 이동값을 설정한다.
    void ConfigureCharacterMovement();

    // 기능: 저장 슬롯에서 조준 설정을 읽어온다.
    void LoadAimSettings();

    // 기능: 서기/앉기 상태에 맞게 카메라 높이를 부드럽게 보간한다.
    void UpdateCameraHeight(float DeltaSeconds);

    // 기능: 우클릭 조준 상태에 맞게 실제 카메라 FOV를 부드럽게 보간한다.
    void UpdateCameraFov(float DeltaSeconds);

    // 기능: 공중에서는 지상보다 약한 입력 배율을 반환한다.
    float GetAirMovementScale() const;

    // 기능: 기존 모드 컴포넌트 변화가 들어와도 캐릭터 이동 속도를 가짜 차량처럼 올리지 않도록 정리한다.
    UFUNCTION()
    void ApplyModeToComponents(EHeroPlayerMode NewMode);

    // 기능: 주변에서 탑승 가능한 차량을 찾는다.
    AHeroDriveableVehiclePawn* FindNearestDriveableVehicle() const;

    // 기능: 주변 차량이 없을 때 영웅 앞에 RaceVehicleCore 기반 차량을 스폰한다.
    AHeroDriveableVehiclePawn* SpawnDriveableVehicleForEntry();

    // 기능: 가장 가까운 차량을 타거나 새 차량을 스폰해 탑승한다.
    void EnterNearestOrSpawnedVehicle();

private:
    UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="Hero|Camera", meta=(AllowPrivateAccess="true"))
    TObjectPtr<UCameraComponent> FirstPersonCamera;

    UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="Hero|Components", meta=(AllowPrivateAccess="true"))
    TObjectPtr<UHeroWeaponComponent> WeaponComponent;

    UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="Hero|Components", meta=(AllowPrivateAccess="true"))
    TObjectPtr<UHeroHealthComponent> HealthComponent;

    UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="Hero|Components", meta=(AllowPrivateAccess="true"))
    TObjectPtr<UHeroVehicleModeComponent> VehicleModeComponent;

    UPROPERTY(VisibleAnywhere, BlueprintReadOnly, Category="Hero|Components", meta=(AllowPrivateAccess="true"))
    TObjectPtr<UHeroTeamComponent> TeamComponent;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Vehicle", meta=(AllowPrivateAccess="true"))
    TSubclassOf<AHeroDriveableVehiclePawn> DriveableVehicleClass;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Vehicle", meta=(AllowPrivateAccess="true"))
    float VehicleEntrySearchRadiusCm = 520.0f;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Vehicle", meta=(AllowPrivateAccess="true"))
    float VehicleSpawnDistanceCm = 520.0f;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Movement", meta=(AllowPrivateAccess="true"))
    float HumanWalkSpeed = 550.0f;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Movement", meta=(AllowPrivateAccess="true"))
    float CrouchWalkSpeed = 330.0f;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Movement", meta=(AllowPrivateAccess="true"))
    float StandingEyeHeight = 74.0f;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Movement", meta=(AllowPrivateAccess="true"))
    float HeroCrouchedEyeHeight = 48.0f;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Movement", meta=(AllowPrivateAccess="true"))
    float CameraHeightInterpSpeed = 16.0f;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Movement", meta=(AllowPrivateAccess="true"))
    float AirMovementInputScale = 0.46f;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Camera", meta=(AllowPrivateAccess="true"))
    float AimFovMultiplier = 0.72f;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Camera", meta=(AllowPrivateAccess="true"))
    float CameraFovInterpSpeed = 18.0f;

    UPROPERTY(EditAnywhere, BlueprintReadWrite, Category="Hero|Settings", meta=(AllowPrivateAccess="true"))
    FHeroAimSettings AimSettings;
};

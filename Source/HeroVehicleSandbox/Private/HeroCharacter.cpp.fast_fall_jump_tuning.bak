#include "HeroCharacter.h"

#include "Camera/CameraComponent.h"
#include "Components/CapsuleComponent.h"
#include "EngineUtils.h"
#include "GameFramework/CharacterMovementComponent.h"
#include "GameFramework/Controller.h"
#include "HeroDriveableVehiclePawn.h"
#include "HeroHealthComponent.h"
#include "HeroSettingsSaveGame.h"
#include "HeroTeamComponent.h"
#include "HeroVehicleModeComponent.h"
#include "HeroWeaponComponent.h"
#include "Kismet/GameplayStatics.h"

// 기능: 1인칭 영웅 캐릭터의 카메라, 무기, 체력, 팀, 이동 기본값을 구성한다.
AHeroCharacter::AHeroCharacter()
{
    PrimaryActorTick.bCanEverTick = true;

    GetCapsuleComponent()->InitCapsuleSize(42.0f, 96.0f);

    FirstPersonCamera = CreateDefaultSubobject<UCameraComponent>(TEXT("FirstPersonCamera"));
    FirstPersonCamera->SetupAttachment(GetCapsuleComponent());
    FirstPersonCamera->SetRelativeLocation(FVector(0.0f, 0.0f, StandingEyeHeight));
    FirstPersonCamera->bUsePawnControlRotation = true;
    FirstPersonCamera->FieldOfView = 103.0f;

    WeaponComponent = CreateDefaultSubobject<UHeroWeaponComponent>(TEXT("HeroWeaponComponent"));
    HealthComponent = CreateDefaultSubobject<UHeroHealthComponent>(TEXT("HeroHealthComponent"));
    VehicleModeComponent = CreateDefaultSubobject<UHeroVehicleModeComponent>(TEXT("HeroVehicleModeComponent"));
    TeamComponent = CreateDefaultSubobject<UHeroTeamComponent>(TEXT("HeroTeamComponent"));

    DriveableVehicleClass = AHeroDriveableVehiclePawn::StaticClass();

    bUseControllerRotationPitch = false;
    bUseControllerRotationYaw = true;
    bUseControllerRotationRoll = false;

    ConfigureCharacterMovement();
}

// 기능: 저장된 조준 설정을 로드하고 체력/모드 이벤트를 연결한다.
void AHeroCharacter::BeginPlay()
{
    Super::BeginPlay();
    LoadAimSettings();
    HealthComponent->OnDeath.AddDynamic(this, &AHeroCharacter::HandleDeath);
    VehicleModeComponent->OnPlayerModeChanged.AddDynamic(this, &AHeroCharacter::ApplyModeToComponents);
    VehicleModeComponent->ExitVehicleMode();
    ApplyModeToComponents(EHeroPlayerMode::Human);
}

// 기능: 매 프레임 카메라 높이와 조준 FOV 전환을 갱신한다.
void AHeroCharacter::Tick(const float DeltaSeconds)
{
    Super::Tick(DeltaSeconds);
    UpdateCameraHeight(DeltaSeconds);
    UpdateCameraFov(DeltaSeconds);
}

// 기능: 영웅 상태의 이동/시점/전투/탑승 입력을 바인딩한다.
void AHeroCharacter::SetupPlayerInputComponent(UInputComponent* PlayerInputComponent)
{
    Super::SetupPlayerInputComponent(PlayerInputComponent);
    PlayerInputComponent->BindAxis(TEXT("MoveForward"), this, &AHeroCharacter::MoveForward);
    PlayerInputComponent->BindAxis(TEXT("MoveRight"), this, &AHeroCharacter::MoveRight);
    PlayerInputComponent->BindAxis(TEXT("Turn"), this, &AHeroCharacter::Turn);
    PlayerInputComponent->BindAxis(TEXT("LookUp"), this, &AHeroCharacter::LookUp);
    PlayerInputComponent->BindAction(TEXT("Jump"), IE_Pressed, this, &ACharacter::Jump);
    PlayerInputComponent->BindAction(TEXT("Jump"), IE_Released, this, &ACharacter::StopJumping);
    PlayerInputComponent->BindAction(TEXT("Crouch"), IE_Pressed, this, &AHeroCharacter::StartHeroCrouch);
    PlayerInputComponent->BindAction(TEXT("Crouch"), IE_Released, this, &AHeroCharacter::StopHeroCrouch);
    PlayerInputComponent->BindAction(TEXT("Fire"), IE_Pressed, this, &AHeroCharacter::StartFire);
    PlayerInputComponent->BindAction(TEXT("Fire"), IE_Released, this, &AHeroCharacter::StopFire);
    PlayerInputComponent->BindAction(TEXT("Aim"), IE_Pressed, this, &AHeroCharacter::StartAim);
    PlayerInputComponent->BindAction(TEXT("Aim"), IE_Released, this, &AHeroCharacter::StopAim);
    PlayerInputComponent->BindAction(TEXT("Reload"), IE_Pressed, this, &AHeroCharacter::Reload);
    PlayerInputComponent->BindAction(TEXT("ToggleVehicleMode"), IE_Pressed, this, &AHeroCharacter::ToggleVehicleMode);
    PlayerInputComponent->BindAction(TEXT("Interact"), IE_Pressed, this, &AHeroCharacter::Interact);
}

// 기능: 앉기 시작 시 기본 Character crouch 처리를 유지한다.
void AHeroCharacter::OnStartCrouch(const float HalfHeightAdjust, const float ScaledHalfHeightAdjust)
{
    Super::OnStartCrouch(HalfHeightAdjust, ScaledHalfHeightAdjust);
}

// 기능: 앉기 종료 시 기본 Character crouch 처리를 유지한다.
void AHeroCharacter::OnEndCrouch(const float HalfHeightAdjust, const float ScaledHalfHeightAdjust)
{
    Super::OnEndCrouch(HalfHeightAdjust, ScaledHalfHeightAdjust);
}

// 기능: 1인칭 카메라 컴포넌트를 반환한다.
UCameraComponent* AHeroCharacter::GetFirstPersonCamera() const
{
    return FirstPersonCamera;
}

// 기능: 영웅 무기 컴포넌트를 반환한다.
UHeroWeaponComponent* AHeroCharacter::GetWeaponComponent() const
{
    return WeaponComponent;
}

// 기능: 영웅 체력 컴포넌트를 반환한다.
UHeroHealthComponent* AHeroCharacter::GetHealthComponent() const
{
    return HealthComponent;
}

// 기능: 기존 가짜 차량 모드 컴포넌트를 반환한다. 실제 주행은 AHeroDriveableVehiclePawn이 담당한다.
UHeroVehicleModeComponent* AHeroCharacter::GetVehicleModeComponent() const
{
    return VehicleModeComponent;
}

// 기능: 팀 컴포넌트를 반환한다.
UHeroTeamComponent* AHeroCharacter::GetTeamComponent() const
{
    return TeamComponent;
}

// 기능: 설정 UI/저장 데이터에서 받은 조준 설정을 캐릭터에 적용한다.
void AHeroCharacter::ApplyAimSettings(const FHeroAimSettings& NewSettings)
{
    AimSettings = NewSettings;
    AimSettings.Clamp();
    if (FirstPersonCamera)
    {
        FirstPersonCamera->SetFieldOfView(AimSettings.FirstPersonFovDegrees);
    }
}

// 기능: 현재 조준 설정을 반환한다.
const FHeroAimSettings& AHeroCharacter::GetAimSettings() const
{
    return AimSettings;
}

// 기능: 현재 앉은 상태인지 반환한다.
bool AHeroCharacter::IsHeroCrouching() const
{
    return bIsCrouched;
}

// 기능: W/S 입력을 영웅 전후 이동으로 처리한다.
void AHeroCharacter::MoveForward(const float Value)
{
    if (Value != 0.0f && !HealthComponent->IsDead())
    {
        AddMovementInput(GetActorForwardVector(), Value * GetAirMovementScale());
    }
}

// 기능: A/D 입력을 영웅 좌우 이동으로 처리한다.
void AHeroCharacter::MoveRight(const float Value)
{
    if (Value != 0.0f && !HealthComponent->IsDead())
    {
        AddMovementInput(GetActorRightVector(), Value * GetAirMovementScale());
    }
}

// 기능: 마우스 X 입력을 Overwatch yaw 0.0066 기반 수평 회전으로 처리한다.
void AHeroCharacter::Turn(const float Value)
{
    if (Controller && Value != 0.0f && (!HealthComponent || !HealthComponent->IsDead()))
    {
        const bool bScoped = WeaponComponent && WeaponComponent->IsAiming();
        FRotator ControlRotation = Controller->GetControlRotation();
        ControlRotation.Yaw += Value * AimSettings.GetFinalDegreesPerCount(bScoped, false);
        Controller->SetControlRotation(ControlRotation);
    }
}

// 기능: 마우스 Y 입력을 설정 반전 옵션만 반영해 수직 회전으로 처리한다.
void AHeroCharacter::LookUp(const float Value)
{
    if (Controller && Value != 0.0f && (!HealthComponent || !HealthComponent->IsDead()))
    {
        const bool bScoped = WeaponComponent && WeaponComponent->IsAiming();
        const float UserInvertSign = AimSettings.bInvertMouseY ? -1.0f : 1.0f;

        FRotator ControlRotation = Controller->GetControlRotation();
        float NormalizedPitch = FRotator::NormalizeAxis(ControlRotation.Pitch);
        NormalizedPitch = FMath::Clamp(
            NormalizedPitch + Value * UserInvertSign * AimSettings.GetFinalDegreesPerCount(bScoped, false),
            -89.0f,
            89.0f);

        ControlRotation.Pitch = NormalizedPitch;
        Controller->SetControlRotation(ControlRotation);
    }
}

// 기능: 현재 무기 발사를 시작한다.
void AHeroCharacter::StartFire()
{
    WeaponComponent->StartFire(FirstPersonCamera);
}

// 기능: 현재 무기 발사를 중지한다.
void AHeroCharacter::StopFire()
{
    WeaponComponent->StopFire();
}

// 기능: 조준 상태를 시작해 줌 FOV 전환을 유도한다.
void AHeroCharacter::StartAim()
{
    WeaponComponent->SetAiming(true);
}

// 기능: 조준 상태를 해제해 기본 FOV로 복귀시킨다.
void AHeroCharacter::StopAim()
{
    WeaponComponent->SetAiming(false);
}

// 기능: 현재 무기를 재장전한다.
void AHeroCharacter::Reload()
{
    WeaponComponent->Reload();
}

// 기능: 앉기 입력을 시작한다.
void AHeroCharacter::StartHeroCrouch()
{
    if (!HealthComponent->IsDead())
    {
        Crouch();
    }
}

// 기능: 앉기 입력을 해제한다.
void AHeroCharacter::StopHeroCrouch()
{
    UnCrouch();
}

// 기능: 가짜 속도 모드 대신 근처 차량 탑승/스폰 탑승을 실행한다.
void AHeroCharacter::ToggleVehicleMode()
{
    EnterNearestOrSpawnedVehicle();
}

// 기능: 상호작용 키로도 실제 차량 탑승을 실행한다.
void AHeroCharacter::Interact()
{
    EnterNearestOrSpawnedVehicle();
}

// 기능: 체력이 0이 되었을 때 입력과 무기를 중지한다.
void AHeroCharacter::HandleDeath()
{
    WeaponComponent->StopFire();
    StopJumping();
    DisableInput(nullptr);
}

// 기능: CharacterMovement를 Overwatch식 즉시 가속/즉시 정지에 가깝게 설정한다.
void AHeroCharacter::ConfigureCharacterMovement()
{
    UCharacterMovementComponent* Movement = GetCharacterMovement();
    Movement->MaxWalkSpeed = HumanWalkSpeed;
    Movement->MaxWalkSpeedCrouched = CrouchWalkSpeed;

    // Ground movement: almost no inertia. Start/stop must feel immediate.
    Movement->MaxAcceleration = 100000.0f;
    Movement->BrakingDecelerationWalking = 100000.0f;
    Movement->GroundFriction = 70.0f;
    Movement->BrakingFriction = 70.0f;
    Movement->BrakingFrictionFactor = 1.0f;
    Movement->bUseSeparateBrakingFriction = true;
    Movement->MinAnalogWalkSpeed = 0.0f;

    // Air movement: still controllable, but weaker than grounded control.
    Movement->JumpZVelocity = 620.0f;
    Movement->AirControl = 0.42f;
    Movement->AirControlBoostMultiplier = 0.65f;
    Movement->AirControlBoostVelocityThreshold = 35.0f;
    Movement->FallingLateralFriction = 0.16f;
    Movement->BrakingDecelerationFalling = 80.0f;

    Movement->bOrientRotationToMovement = false;
    Movement->NavAgentProps.bCanCrouch = true;
    GetCapsuleComponent()->SetCanEverAffectNavigation(false);
}


// 기능: 저장 슬롯에서 조준 설정을 읽어온다.
void AHeroCharacter::LoadAimSettings()
{
    if (UHeroSettingsSaveGame* Save = Cast<UHeroSettingsSaveGame>(UGameplayStatics::LoadGameFromSlot(TEXT("HeroVehicleSettings"), 0)))
    {
        AimSettings = Save->AimSettings;
    }
    AimSettings.Clamp();
    ApplyAimSettings(AimSettings);
}

// 기능: 서기/앉기 상태에 맞게 카메라 높이를 부드럽게 보간한다.
void AHeroCharacter::UpdateCameraHeight(const float DeltaSeconds)
{
    if (!FirstPersonCamera)
    {
        return;
    }

    const float TargetHeight = bIsCrouched ? HeroCrouchedEyeHeight : StandingEyeHeight;
    const FVector CurrentLocation = FirstPersonCamera->GetRelativeLocation();
    const float NewZ = FMath::FInterpTo(CurrentLocation.Z, TargetHeight, DeltaSeconds, CameraHeightInterpSpeed);
    FirstPersonCamera->SetRelativeLocation(FVector(CurrentLocation.X, CurrentLocation.Y, NewZ));
}

// 기능: 우클릭 조준 상태에 맞게 실제 카메라 FOV를 부드럽게 보간한다.
void AHeroCharacter::UpdateCameraFov(const float DeltaSeconds)
{
    if (!FirstPersonCamera)
    {
        return;
    }

    const bool bAiming = WeaponComponent && WeaponComponent->IsAiming();
    const float TargetFov = bAiming
        ? FMath::Clamp(AimSettings.FirstPersonFovDegrees * AimFovMultiplier, 55.0f, AimSettings.FirstPersonFovDegrees)
        : AimSettings.FirstPersonFovDegrees;

    const float NewFov = FMath::FInterpTo(FirstPersonCamera->FieldOfView, TargetFov, DeltaSeconds, CameraFovInterpSpeed);
    FirstPersonCamera->SetFieldOfView(NewFov);
}

// 기능: 공중에서는 지상보다 약한 입력 배율을 반환한다.
float AHeroCharacter::GetAirMovementScale() const
{
    const UCharacterMovementComponent* Movement = GetCharacterMovement();
    return Movement && Movement->IsFalling() ? AirMovementInputScale : 1.0f;
}

// 기능: 기존 모드 컴포넌트 변화가 들어와도 캐릭터 이동 속도를 가짜 차량처럼 올리지 않도록 정리한다.
void AHeroCharacter::ApplyModeToComponents(const EHeroPlayerMode NewMode)
{
    (void)NewMode;
    WeaponComponent->SetPlayerMode(EHeroPlayerMode::Human);
    GetCharacterMovement()->MaxWalkSpeed = HumanWalkSpeed;
    GetCharacterMovement()->MaxWalkSpeedCrouched = CrouchWalkSpeed;
}

// 기능: 주변에서 탑승 가능한 차량을 찾는다.
AHeroDriveableVehiclePawn* AHeroCharacter::FindNearestDriveableVehicle() const
{
    UWorld* World = GetWorld();
    if (!World)
    {
        return nullptr;
    }

    AHeroDriveableVehiclePawn* BestVehicle = nullptr;
    float BestDistanceSq = FMath::Square(VehicleEntrySearchRadiusCm);

    for (TActorIterator<AHeroDriveableVehiclePawn> It(World); It; ++It)
    {
        AHeroDriveableVehiclePawn* Vehicle = *It;
        if (!Vehicle || Vehicle->HasDriver())
        {
            continue;
        }

        const float DistanceSq = FVector::DistSquared(Vehicle->GetActorLocation(), GetActorLocation());
        if (DistanceSq <= BestDistanceSq)
        {
            BestDistanceSq = DistanceSq;
            BestVehicle = Vehicle;
        }
    }

    return BestVehicle;
}

// 기능: 주변 차량이 없을 때 영웅 앞에 RaceVehicleCore 기반 차량을 스폰한다.
AHeroDriveableVehiclePawn* AHeroCharacter::SpawnDriveableVehicleForEntry()
{
    UWorld* World = GetWorld();
    UClass* SpawnClass = DriveableVehicleClass ? DriveableVehicleClass.Get() : AHeroDriveableVehiclePawn::StaticClass();
    if (!World || !SpawnClass)
    {
        return nullptr;
    }

    const FVector SpawnLocation = GetActorLocation() + GetActorForwardVector() * VehicleSpawnDistanceCm + FVector(0.0f, 0.0f, 40.0f);
    const FRotator SpawnRotation(0.0f, GetActorRotation().Yaw, 0.0f);

    FActorSpawnParameters SpawnParams;
    SpawnParams.Owner = GetController();
    SpawnParams.SpawnCollisionHandlingOverride = ESpawnActorCollisionHandlingMethod::AdjustIfPossibleButAlwaysSpawn;

    return World->SpawnActor<AHeroDriveableVehiclePawn>(SpawnClass, SpawnLocation, SpawnRotation, SpawnParams);
}

// 기능: 가장 가까운 차량을 타거나 새 차량을 스폰해 탑승한다.
void AHeroCharacter::EnterNearestOrSpawnedVehicle()
{
    if (HealthComponent && HealthComponent->IsDead())
    {
        return;
    }

    AController* CurrentController = Controller;
    if (!CurrentController)
    {
        return;
    }

    AHeroDriveableVehiclePawn* Vehicle = FindNearestDriveableVehicle();
    if (!Vehicle)
    {
        Vehicle = SpawnDriveableVehicleForEntry();
    }

    if (Vehicle)
    {
        Vehicle->EnterVehicle(this, CurrentController);
    }
}

// 기능: 총기 반동/피격 흔들림처럼 마우스 반전 옵션과 무관해야 하는 카메라 킥을 적용한다.
void AHeroCharacter::ApplyViewKick(const float PitchKickDegrees, const float YawKickDegrees)
{
    if (!Controller || (HealthComponent && HealthComponent->IsDead()))
    {
        return;
    }

    FRotator ControlRotation = Controller->GetControlRotation();
    float NormalizedPitch = FRotator::NormalizeAxis(ControlRotation.Pitch);
    NormalizedPitch = FMath::Clamp(NormalizedPitch - FMath::Abs(PitchKickDegrees), -89.0f, 89.0f);

    ControlRotation.Pitch = NormalizedPitch;
    ControlRotation.Yaw += YawKickDegrees;
    Controller->SetControlRotation(ControlRotation);
}
